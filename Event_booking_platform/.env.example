# Database (used by both the mysql and api services)
MYSQL_DATABASE=event_booking_db
MYSQL_USER=event_booking_user
MYSQL_PASSWORD=change_me_local
MYSQL_ROOT_PASSWORD=change_me_root

# Security - generate a real value: openssl rand -base64 48
JWT_SECRET=replace_with_a_base64_encoded_secret_of_at_least_32_bytes
JWT_EXPIRATION=3600000

# Frontend origin(s): CORS allow-list and the base URL used in password reset emails
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_BASE_URL=http://localhost:5173

# Outside Docker Compose / in prod (Compose already points the api at the Mailpit container)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@example.com
