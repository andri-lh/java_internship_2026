# Base URL of the API.
# Leave as /api/v1 in development (Vite proxies /api to localhost:8080) or when the host rewrites /api to the backend.
# For a separately hosted backend, use its full URL (the backend must list this site in CORS_ALLOWED_ORIGINS):
# VITE_API_BASE_URL=https://your-api.example.com/api/v1
VITE_API_BASE_URL=/api/v1
