# Copy to .env.prod and fill in. Never commit .env.prod.

# --- Public address (see README, section 18: Deployment on AWS EC2) ---
# :80 for plain HTTP, or <your-ip-with-dashes>.sslip.io / your domain for automatic HTTPS
SITE_ADDRESS=:80
# The exact URL people open, used for CORS and email links (https://... when SITE_ADDRESS is a hostname)
APP_FRONTEND_BASE_URL=http://localhost

# --- Database ---
MYSQL_DATABASE=event_booking_db
MYSQL_USER=event_booking_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# --- Security --- generate: openssl rand -base64 48
JWT_SECRET=change_me
JWT_EXPIRATION=3600000

# --- First admin (created once, only if no admin exists) ---
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=Change#Me2026

# --- Optional demo content (set true once, then false) ---
DEMO_DATA_ENABLED=false
DEMO_DATA_PASSWORD=Demo!Showcase2026

# --- Email (optional). Without SMTP keep verification off. ---
EMAIL_VERIFICATION_REQUIRED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# JVM heap for the API in MB (384 fits a 1 GB instance with swap; use 512+ on 2 GB)
API_HEAP_MB=384
